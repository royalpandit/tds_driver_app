{
  "builds": [
    {
      "name": "optimized_release",
      "flutter_command": "build",
      "flutter_command_args": [
        "apk",
        "--release",
        "--split-per-abi",
        "--obfuscate",
        "--split-debug-info=build/app/outputs/symbols",
        "--target-platform=android-arm,android-arm64,android-x64"
      ]
    }
  ]
}